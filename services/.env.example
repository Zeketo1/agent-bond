# Copy to .env and fill in. Never commit .env.
NEAR_RPC_URL=https://test.rpc.fastnear.com
BOND_CONTRACT=agentbond.your-name.testnet

GUARDIAN_ACCOUNT=guardian.your-name.testnet
GUARDIAN_KEY=ed25519:...
AGENT_ACCOUNT=agent.your-name.testnet
AGENT_KEY=ed25519:...

# Comma-separated recipients the sponsor trusts (the guardian treats everyone else as unknown)
TRUSTED_RECIPIENTS=vendor.your-name.testnet
VENDOR_ACCOUNT=vendor.your-name.testnet
ATTACKER_ACCOUNT=attacker.your-name.testnet

# Optional: private AI review (NEAR AI Cloud). Without it, the guardian uses rules only.
NEAR_AI_API_KEY=
# AGENT_MODE=llm   # let a real LLM play the agent instead of the scripted one
